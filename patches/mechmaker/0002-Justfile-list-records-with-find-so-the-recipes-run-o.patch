From 7fcbe29a2db5ba97bc94234c3554b62876f3318f Mon Sep 17 00:00:00 2001
From: Ginnie Hench <ginniehench@gmail.com>
Date: Sat, 3 Oct 2026 22:26:30 -0400
Subject: [PATCH 2/2] Justfile: list records with find, so the recipes run on
 bash 3

validate-terms-all and validate-references-all gathered records with
`shopt -s globstar` and a ** glob. globstar needs bash 4. macOS ships
bash 3.2, where the shopt line fails and the recipe stops before
checking anything, so `just qc-full` could not pass on a Mac.

List the records with find instead, which works on both.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 template/justfile.jinja | 10 ++++++----
 tests/test_template.py  |  7 +++++++
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/template/justfile.jinja b/template/justfile.jinja
index ed3d38a..82871ad 100644
--- a/template/justfile.jinja
+++ b/template/justfile.jinja
@@ -54,8 +54,9 @@ validate-all:
 validate-terms-all:
     #!/usr/bin/env bash
     set -euo pipefail
-    shopt -s nullglob globstar
-    files=({{records}}/**/*.yaml)
+    # find, not the ** glob: globstar needs bash 4, and macOS ships bash 3.2.
+    files=()
+    while IFS= read -r f; do files+=("$f"); done < <(find {{records}} -name '*.yaml' | sort)
     if [ ${#files[@]} -eq 0 ]; then echo "No records under {{records}}."; exit 0; fi
     uv run python -m {{slug}}.termcheck validate-data "${files[@]}" -s {{schema}} -t {{record_class}} --labels -c {{oak_config}}
 
@@ -69,8 +70,9 @@ check-identity *files:
 validate-references-all:
     #!/usr/bin/env bash
     set -euo pipefail
-    shopt -s nullglob globstar
-    files=({{records}}/**/*.yaml)
+    # find, not the ** glob: globstar needs bash 4, and macOS ships bash 3.2.
+    files=()
+    while IFS= read -r f; do files+=("$f"); done < <(find {{records}} -name '*.yaml' | sort)
     if [ ${#files[@]} -eq 0 ]; then echo "No records under {{records}}."; exit 0; fi
     uv run linkml-reference-validator validate data "${files[@]}" --schema {{schema}} --target-class {{record_class}} --config {{ref_config}}
 
diff --git a/tests/test_template.py b/tests/test_template.py
index 2c5390e..318691b 100644
--- a/tests/test_template.py
+++ b/tests/test_template.py
@@ -184,6 +184,13 @@ def test_docs_site_config(generated):
         assert (dest / "docs" / page).exists(), page
 
 
+def test_recipes_run_on_bash_3(generated):
+    """macOS ships bash 3.2, which has no globstar: `shopt -s globstar` stops
+    the recipe before it checks anything."""
+    _, _, dest = generated
+    assert not re.search(r"shopt[^\n]*globstar", (dest / "justfile").read_text())
+
+
 def test_schema_pages_are_in_a_folder_per_kind(generated):
     """Every Mech has a Term class and a term slot. In one folder their pages
     are Term.md and term.md, one file where case is ignored, and the docs
